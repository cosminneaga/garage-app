{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "itsgoingd/clockwork": "^5.3",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.17",
        "laravel/pulse": "^1.7",
        "laravel/reverb": "^1.0",
        "laravel/scout": "^11.2",
        "laravel/telescope": "^5.19",
        "laravel/tinker": "^2.10.1",
        "spatie/fork": "^1.2",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-permission": "^7.2",
        "themesberg/flowbite-blade-icons": "^1.4"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "driftingly/rector-laravel": "^2.2",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.1",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate:dev:withVehicle": [
            "@php artisan migrate:fresh",
            "@php artisan db:seed --class=DevUsers",
            "@php artisan db:seed --class=VehicleSeeder"
        ],
        "migrate:dev": [
            "@php artisan migrate:fresh",
            "@php artisan db:seed --class=LocalEnv"
        ],
        "migrate:prod": [
            "@php artisan migrate",
            "@php artisan db:seed --class=PermissionsSeeder",
            "@php artisan db:seed --class=CountriesSeeder",
            "@php artisan db:seed --class=VehicleSeeder"
        ],
        "migrate:test": [
            "@php artisan migrate:fresh",
            "@php artisan db:seed --class=TestSeeder"
        ],
        "migrate:fresh": [
            "@php artisan migrate:fresh",
            "@php artisan db:seed --class=PermissionsSeeder",
            "@php artisan db:seed"
        ],
        "clear": [
            "@php artisan optimize:clear",
            "@php artisan permission:cache-reset",
            "@php artisan activitylog:clean",
            "@php artisan config:clear",
            "composer dump-autoload"
        ],
        "storage": [
            "@php artisan storage:link"
        ],
        "pest:filter": [
            "bash -c './vendor/bin/pest $(find tests -type f -name \"*$0*\") --bail --profile'"
        ],
        "pest": [
            "composer clear",
            "vendor/bin/pest --configuration ./phpunit.xml --bail --profile"
        ],
        "format": [
            "@php artisan ide-helper:models -RW --write-mixin",
            "vendor/bin/rector",
            "vendor/bin/pint --parallel",
            "npx prettier --write --log-level=warn 'resources/views/**/**.blade.php'"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan reverb:start\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:models -RW"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
