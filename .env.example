APP_NAME=Garage_Application
APP_ENV=local
APP_KEY=base64:app-key
APP_DEBUG=true
APP_URL=http://localhost:8000
VITE_DEV_SERVER_URL=http://localhost:5173

APP_LOCALE=en
APP_TIMEZONE=Europe/Bucharest
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# main database
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=garage
DB_USERNAME=
DB_PASSWORD=

# world database
WORLD_DB_CONNECTION=world
WORLD_DB_HOST=127.0.0.1
WORLD_DB_PORT=3306
WORLD_DB_DATABASE=world
WORLD_DB_USERNAME=
WORLD_DB_PASSWORD=
WORLD_CACHE_ENABLED=true
WORLD_CACHE_TTL=86400
WORLD_GEOLOCATE_CACHE_TTL=86400
MAXMIND_LICENSE_KEY=
WORLD_GEOLOCATE_FALLBACK_API=true

# session
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=none
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# cache
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=
MEMCACHED_HOST=127.0.0.1
REDIS_URL=
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_TIMEOUT=60

# email
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@garageapp.com"
MAIL_FROM_NAME="${APP_NAME}"

# aws
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
TURBINE_UI_THEME="kinetic"
TELESCOPE_ENABLED=true

# search
SCOUT_DRIVER=database
SCOUT_PREFIX=
SCOUT_QUEUE=true

# reverb
REVERB_SERVER=reverb
REVERB_APP_ID=974109
REVERB_APP_KEY=reverb-app-key
REVERB_APP_SECRET=reverb-app-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT="${REVERB_PORT}"
REVERB_SERVER_PATH=
REVERB_MAX_REQUEST_SIZE=10000
REVERB_SCALING_ENABLED=false
REVERB_SCALING_CHANNEL=reverb
REVERB_PULSE_INGEST_INTERVAL=15
REVERB_TELESCOPE_INGEST_INTERVAL=15
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_MAX_CONNECTIONS=1000
REVERB_APP_MAX_MESSAGE_SIZE=10000
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=members
REVERB_APP_RATE_LIMITING_ENABLED=false
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=60
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60
REVERB_APP_RATE_LIMIT_TERMINATE=false

# vite -- reverb
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# pagination
PAGINATE_DEFAULT_PER_PAGE=10

# server
OCTANE_SERVER=roadrunner
OCTANE_HTTPS=false
