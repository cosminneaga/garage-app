{
    "preset": "psr12",
    "exclude": [
        "vendor",
        "storage",
        "bootstrap/cache",
        "json"
    ],
    "rules": {
        "array_indentation": true,
        "align_multiline_comment": true,
        "array_syntax": true,
        "assign_null_coalescing_to_coalesce_equal": true,
        "attribute_block_no_spaces": true,
        "attribute_empty_parentheses": false
    }
}
